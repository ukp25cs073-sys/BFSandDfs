#include <stdio.h>
#include <string.h>

#define MAX 20

char names[MAX][50];
int graph[MAX][MAX];
int visited[MAX];
int n;

/* Breadth First Search */
int BFS(int start, char target[]) {
    int queue[MAX];
    int front = 0, rear = 0;
    int found = 0;

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    visited[start] = 1;
    queue[rear++] = start;

    printf("\nBFS Traversal: ");

    while (front < rear) {
        int current = queue[front++];

        printf("%s ", names[current]);

        if (strcmp(names[current], target) == 0)
            found = 1;

        for (int i = 0; i < n; i++) {
            if (graph[current][i] && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }

    printf("\nBFS Result: %s\n",
           found ? "File Found" : "File Not Found");

    return found;
}

/* Depth First Search */
void DFS_Visit(int current, char target[], int *found) {
    visited[current] = 1;

    printf("%s ", names[current]);

    if (strcmp(names[current], target) == 0)
        *found = 1;

    for (int i = 0; i < n; i++) {
        if (graph[current][i] && !visited[i]) {
            DFS_Visit(i, target, found);
        }
    }
}

int DFS(int start, char target[]) {
    int found = 0;

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    printf("\nDFS Traversal: ");

    DFS_Visit(start, target, &found);

    printf("\nDFS Result: %s\n",
           found ? "File Found" : "File Not Found");

    return found;
}

int main() {
    int edges, u, v, start;
    char target[50];

    printf("Enter number of files/directories (max %d): ", MAX);
    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        printf("Invalid number of nodes!\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        printf("Enter name of node %d: ", i);
        scanf("%49s", names[i]);
    }

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            graph[i][j] = 0;

    printf("Enter number of connections: ");
    scanf("%d", &edges);

    if (edges < 0 || edges > n * (n - 1) / 2) {
        printf("Invalid number of connections!\n");
        return 1;
    }

    printf("Enter connections using node indices (u v):\n");

    for (int i = 0; i < edges; i++) {
        scanf("%d %d", &u, &v);

        if (u < 0 || u >= n || v < 0 || v >= n || u == v) {
            printf("Invalid connection!\n");
            return 1;
        }

        graph[u][v] = 1;
        graph[v][u] = 1;
    }

    printf("\nNode Index List:\n");
    for (int i = 0; i < n; i++)
        printf("%d -> %s\n", i, names[i]);

    printf("\nEnter starting node index: ");
    scanf("%d", &start);

    if (start < 0 || start >= n) {
        printf("Invalid starting node!\n");
        return 1;
    }

    printf("Enter file name to search: ");
    scanf("%49s", target);

    BFS(start, target);
    DFS(start, target);

    return 0;
}
